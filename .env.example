# Dedicated synthetic lab database only. Never use KHLIM production infrastructure.
DATABASE_URL=postgresql://lab:lab_local_only@127.0.0.1:54329/khlim_player_lab?schema=public
APP_URL=http://127.0.0.1:3000
AUTH_PROVIDER=lab

# Local-lab password reset signing. Set a unique value if this prototype is shared beyond one machine.
LAB_RESET_SECRET=replace-with-a-local-random-value

# Optional isolated Supabase Auth project; pre-map its subject to User.externalAuthId.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
